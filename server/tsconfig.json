{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["*.ts", "routes/**/*.ts", "middleware/**/*.ts", "scripts/**/*.ts", "types/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
